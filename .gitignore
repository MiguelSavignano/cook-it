# Python
src/.venv/
**/__pycache__/
*.pyc

# Per-machine settings overrides. The shared config (src/settings.yml) IS
# committed -- see src/settings.py for the precedence; this is only for what
# genuinely differs per machine, like your mic device.
src/settings.local.yml

# TLS cert -- self-signed, regenerated automatically by run_web.sh
src/certs/

# Runtime state / generated at runtime, not source
src/session_state.json
src/cache_llm/
src/*.wav

# Downloaded model (63MB, third-party asset -- see docs/voz.md for what/why)
src/voices/

# Frontend (src/frontend/, Vite+React) -- built fresh by run_web.sh/`npm
# run build`, not source. node_modules is frontend/.gitignore's job (it's
# inside that directory); static_dist lives one level up (see
# frontend/vite.config.ts's outDir), so it needs its own entry here.
src/static_dist/

# Claude Code's own working area -- agent worktrees and session state. Git
# records a directory with its own .git as a submodule, so this landed in
# the index as a gitlink with no .gitmodules: a clone would get an empty
# folder and a broken `git submodule update`.
.claude/

# OS/editor cruft
.DS_Store

images/test/

# Google Drive credentials. drive_client.json is your OAuth client from
# Google Cloud; drive_token.json is the token it produced -- that one is a
# key to your Drive, treat it like a password (see src/drive.py).
src/drive_client.json
src/drive_token.json
client_secret*.json

# YOUR recipe library. It lives in the browser (IndexedDB) and syncs with
# Google Drive; this is only the mirror the server needs to match speech and
# resolve shared links. Never source -- see src/recipe_store.py.
src/recipes_library/

# Recipes generated at runtime (LLM/pantry) and given a shareable uuid --
# runtime state, not source (see src/recipe_store.py).
src/recipes_shared/


client_secret.json
