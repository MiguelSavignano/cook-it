# Copy to .env (or export these before running) and adjust for your machine.
# Everything has a sane default for a single-machine local setup, so this file
# is only needed if your Ollama server, model, or mic device differ.

# Where Ollama is reachable. Defaults to a local install; point this at
# another machine on your network if you're not running Ollama on the same
# box as Cook-It (e.g. http://192.168.1.50:11434).
OLLAMA_BASE_URL=http://localhost:11434

# Which Ollama model to use for recipe narration/Q&A. Must already be pulled
# (`ollama pull gemma3`) and, per docs/feasibility.md, must fit comfortably in
# your available RAM -- gemma3:4b is the validated default on a 15GB machine.
OLLAMA_MODEL=gemma3

# Which Piper voice to speak with. Must be a voice name from
# https://huggingface.co/rhasspy/piper-voices (e.g. es_ES-carlfm-x_low,
# es_MX-claude-high) -- setup.sh downloads whichever one this is set to.
COOKIT_VOICE=es_ES-davefx-medium

# --- CLI scripts only (assistant_poc.py / next_step.py) ---
# Not needed for the web app (poc/api.py) -- the browser handles recording.

# ALSA device for `arecord`, machine-specific. List yours with `arecord -l`.
COOKIT_MIC_DEVICE=plughw:1,0

# How many seconds to record per push-to-talk turn.
COOKIT_RECORD_SECONDS=7
